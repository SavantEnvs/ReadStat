# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it), dropping only local
# autotools build artifacts and editor/OS cruft (mirrors this repo's own .gitignore).

# ── autotools build outputs / local cruft ────────────────────────────────────
**/.deps/
**/.libs/
**/*.lo
**/*.o
*.a
*.la
autom4te.cache/
aclocal.m4
compile
config.guess
config.log
config.status
config.sub
configure
configure~
depcomp
install-sh
ltmain.sh
libtool
m4/
Makefile
Makefile.in
missing
test-driver
readstat
generate_corpus
test_readstat
test_dta_days
test_sav_date
test_double_decimals
**/__pycache__/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
